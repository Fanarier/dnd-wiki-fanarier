","passive":[{"text":"Стабильность +15","stat":"stability","value":15},{"text":"Мораль +30","stat":"morale","value":30}],"note":{"text":"Развивается","color":"#6fd6e8"}},{"id":"fayegen","name":"Фэйген","frame":"blue","passive":[{"text":"Стабильность +5","stat":"stability","value":5},{"text":"Изучение территории +30%"}],"role":{"kind":"specialist","effects":[{"text":"Поиск +10%"},{"text":"Военный потенциал +20","stat":"war","value":20}]}}],"outposts":[{"id":"o1","type":"mine","x":590,"y":150,"places":5,"workers":5,"specialist":"Шахтёр","yields":{"iron":25,"coal":45},"state":"active"},{"id":"o2","type":"quarry","x":1040,"y":290,"places":5,"workers":5,"specialist":"Каменщик","yields":{"stone":150,"clay":40},"state":"active"},{"id":"o3","type":"logging","x":1210,"y":330,"places":5,"workers":5,"specialist":"Лесоруб","yields":{"wood":125,"fiber":30},"state":"depleting"}],"adjust":[{"res":"wood","value":50,"label":"Сбор хвороста жителями"},{"res":"wood","value":-74.1,"label":"Стройка"},{"res":"stone","value":-28,"label":"Стройка"},{"res":"build","value":-60,"label":"Стройка"},{"res":"clay","value":-10,"label":"Стройка"}],"events":[{"id":"e001","title":"Спокойствие","type":"approve","duration":["permanent"],"deadline":null,"text":"У нас достаточно еды! Поэтому никто не голодает. Мы довольны!","decision":"Заебись (лайк)","effect":"Еды достаточно. Мораль +0.2/житель","location":"Урюпинск","createdAt":1776646800000},{"id":"e002","title":"Спокойствие","type":"approve","duration":["permanent"],"deadline":null,"text":"У нас достаточно воды! Поэтому никто не испытывает жажды. Мы довольны!","decision":"Заебись (лайк)","effect":"Воды достаточно. Мораль +0.2/житель","location":"Урюпинск","createdAt":1776650400000},{"id":"e003","title":"Стабильность","type":"message","duration":["permanent"],"deadline":null,"text":"У нас всё спокойно и каждый житель на своём месте. Это умиротворяет.","decision":"Заебись (лайк)","effect":"В поселении всё спокойно. Стабильность +25","location":"Урюпинск","createdAt":1776654000000},{"id":"e004","title":"Нехватка ресурса","type":"problem","duration":["decide"],"deadline":null,"text":"У нас маловато «Стройматериалы». Поэтому строительство сильно замедлилось. Как мы решим эту проблему, господин Белатор?","decision":"Наймём несколько мастеров из Ширатори, а также построим 2е новых мастерских.","effect":"Не хватает «Стройматериалы». Скорость строительства −75%","location":"Урюпинск","createdAt":1776657600000},{"id":"e005","title":"Строительство завершено","type":"done","duration":["quick"],"deadline":"2026-04-30","text":"Мы наконец завершили крупный проект! Мы построили «Деревянную стену». Теперь жители чувствуют себя в безопасности за стенами. А мы теперь можем выставлять патрули!","decision":"Лично Белатор займётся тренировкой новых солдат","effect":"Постройка «Деревянная стена» завершена","location":"Урюпинск","createdAt":1776661200000},{"id":"e006","title":"Новый район","type":"done","duration":["quick"],"deadline":"2026-05-07","text":"Мы полностью исследовали и разведали новую местность на Севере. Теперь там основан новый район. Можно строить, господин Белатор! Жители немного обрадовались этому событию","decision":"Будем расширяться (ставить новые дома для жизни граждан)","effect":"Разведана земля на Севере","location":"Урюпинск","createdAt":1776664800000},{"id":"e007","title":"Ранчо","type":"message","duration":["decide"],"deadline":"2026-05-07","text":"Господин Белатор, быть может нам стоит построить «Ранчо»? Это хороший источник (Мясной пищи), а главное мы сможем тратить излишки (Соломы).","decision":"Соглашаюсь на эту идею, но только когда мы построим мастерские и решим проблему с материалами","effect":"Жители предлагают построить «Ранчо»","location":"Урюпинск","createdAt":1776668400000},{"id":"e008","title":"Аванпост выработан","type":"important","duration":["decide"],"deadline":"2026-05-07","text":"Господин Белатор, (Аванпост) «Вырубка» сворачивает деятельность. Так как там осталось мало деревьев. Дальнейшая рубка уничтожит часть леса. Мы же не хотим этого? Впрочем мы можем вырубить эту часть леса полностью. Однако некоторые жители это не одобрят…","decision":"Займёмся вырубкой чуть дальше, в сторону шахты, а также начнём создание дороги для простого доступа к ресурсам земли","effect":"Аванпост «Вырубка» был выработан и закрыт","location":"Урюпинск","createdAt":1776672000000},{"id":"e009","title":"Обрушение в шахте","type":"alarm","duration":["decide"],"deadline":"2026-05-14","text":"Господин Белатор! При добыче (Угля) на (Аванпосте) «Шахта» обрушился один из тоннелей. К счастью никто из рабочих сильно не пострадал. Надо оперативно решить эту проблему. Пока кого нибудь не засыпало в этой шахте!","decision":"Выполню переобучение для шахтёров, так как защита и здоровье граждан это самое важное. Деятельность в шахтах приостановить но переобучения.","effect":"На аванпосте «Шахта» произошёл инцидент","location":"Урюпинск","createdAt":1776675600000},{"id":"e010","title":"Новые товары!","type":"message","duration":["routine"],"deadline":"2026-05-14","text":"В наше поселение прибыл (Караван) из 5 торговцев Кицунэ. Они привезли разные товары прямо из Ширатори. Наши поселенцы с радостью покупают товары! А поселение получает с этого дополнительный доход!","decision":"Заебись (лайк)","effect":"В поселение прибыл торговый караван «Кицунэ»","location":"Урюпинск","createdAt":1776679200000},{"id":"e011","title":"Дикие Варги!","type":"threat","duration":["decide","quick"],"deadline":"2026-05-14","text":"В окрестностях нашего поселения охотники обнаружили мигрирующие стаи «Варгов». Надо что-то предпринять господин Белатор. Варги в любой момент могут совершить набег на поселение. Кроме того они представляют опасность для наших охотников и собирателей!","decision":"Обсудить с охотниками и фермерами вариант с приручением диких собак, но не в коем случае не рисковать здоровьем граждан","effect":"В окрестных лесах появились опасные монстры! Угроза +45","location":"Урюпинск","createdAt":177668